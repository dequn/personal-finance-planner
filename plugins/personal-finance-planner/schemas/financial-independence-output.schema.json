{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/personal-finance-planner/financial-independence-output.schema.json",
  "title": "Financial Independence Calculation Output",
  "type": "object",
  "required": [
    "calculation_version",
    "currency",
    "value_basis",
    "base_year",
    "target_year",
    "years_to_target",
    "target_age_range",
    "current_investable_assets_cny",
    "spending_reconciliation",
    "capital_targets",
    "projections",
    "warnings",
    "formula_notes",
    "provenance_card_ids"
  ],
  "properties": {
    "calculation_version": {"const": "0.1.0"},
    "currency": {"const": "CNY"},
    "value_basis": {"type": "string"},
    "base_year": {"type": "integer"},
    "target_year": {"type": "integer"},
    "years_to_target": {"type": "integer", "minimum": 1},
    "target_age_range": {
      "type": "array",
      "prefixItems": [{"type": "integer"}, {"type": "integer"}],
      "minItems": 2,
      "maxItems": 2
    },
    "current_investable_assets_cny": {"type": "number", "minimum": 0},
    "spending_reconciliation": {
      "type": "object",
      "required": ["first_scenario_cny", "component_total_cny", "components_match"]
    },
    "capital_targets": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "projections": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "formula_notes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "provenance_card_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
