{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/personal-finance-planner/home-opportunity-output.schema.json",
  "title": "Home Opportunity Scenario Output",
  "type": "object",
  "required": [
    "calculation_version",
    "currency",
    "value_basis",
    "base_year",
    "target_year",
    "purchase_year",
    "assumptions",
    "purchase",
    "mortgage",
    "target_year_result",
    "minimum_investable_assets_real_cny",
    "yearly_cashflows",
    "warnings",
    "provenance_card_ids"
  ],
  "properties": {
    "calculation_version": {"const": "home-0.3.0"},
    "currency": {"const": "CNY"},
    "value_basis": {"type": "string"},
    "base_year": {"type": "integer"},
    "target_year": {"type": "integer"},
    "purchase_year": {"type": "integer"},
    "assumptions": {
      "type": "object",
      "required": [
        "annual_real_return_pct",
        "annual_inflation_pct",
        "nominal_portfolio_return_pct",
        "income_start_year",
        "cashflow_start_year",
        "fi_withdrawal_rate_pct",
        "mortgage_reserve_mode",
        "mortgage_reserve_annual_real_return_pct"
      ]
    },
    "purchase": {
      "type": "object",
      "required": [
        "home_price_real_cny",
        "home_price_nominal_at_purchase_cny",
        "down_payment_pct",
        "down_payment_nominal_cny",
        "transaction_cost_nominal_cny",
        "renovation_and_furnishing_nominal_cny",
        "upfront_cash_nominal_cny",
        "post_upfront_investable_assets_real_cny",
        "emergency_fund_preserved_after_purchase"
      ]
    },
    "mortgage": {
      "type": "object",
      "required": [
        "mortgage_type",
        "loan_principal_nominal_cny",
        "commercial_loan_principal_nominal_cny",
        "annual_rate_pct",
        "commercial_monthly_payment_nominal_cny",
        "provident_fund_loan_principal_nominal_cny",
        "provident_fund_annual_rate_pct",
        "provident_fund_monthly_payment_nominal_cny",
        "term_years",
        "monthly_payment_nominal_cny",
        "annual_payment_nominal_cny",
        "paid_months_at_target",
        "remaining_principal_nominal_at_target_cny",
        "commercial_remaining_principal_nominal_at_target_cny",
        "provident_fund_remaining_principal_nominal_at_target_cny",
        "remaining_principal_real_at_target_cny",
        "discounted_remaining_payments_real_at_target_cny"
      ]
    },
    "target_year_result": {
      "type": "object",
      "required": [
        "permanent_annual_spending_real_cny",
        "permanent_spending_capital_real_cny",
        "mortgage_payoff_reserve_real_cny",
        "mortgage_funding_reserve_real_cny",
        "mortgage_reserve_mode",
        "total_fi_target_real_cny",
        "projected_investable_assets_real_cny",
        "gap_real_cny",
        "surplus_real_cny",
        "fi_target_met"
      ]
    },
    "minimum_investable_assets_real_cny": {"type": "number"},
    "yearly_cashflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "year",
          "home_owned",
          "income_nominal_cny",
          "spending_nominal_cny",
          "mortgage_payment_nominal_cny",
          "end_investable_assets_real_cny"
        ]
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "provenance_card_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
