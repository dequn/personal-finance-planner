{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/personal-finance-planner/planning-session-route-output.schema.json",
  "title": "Financial Planning Session Route Output v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "routing_version",
    "workflow_registry_version",
    "requested_capability",
    "next_stage",
    "next_skill",
    "next_mcp_prompt",
    "next_tools",
    "reason_codes",
    "blocked_by",
    "requires_user_choice",
    "available_next_capabilities",
    "selection_mode",
    "evaluated_goal_ids",
    "matched_goal_ids",
    "candidate_workflows",
    "safety_boundary"
  ],
  "properties": {
    "routing_version": {"const": "planning-route-0.2.0"},
    "workflow_registry_version": {"const": "planning-workflows-0.2.0"},
    "requested_capability": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "next_stage": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "next_skill": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "next_mcp_prompt": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "next_tools": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "uniqueItems": true
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "uniqueItems": true
    },
    "blocked_by": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "uniqueItems": true
    },
    "requires_user_choice": {"type": "boolean"},
    "available_next_capabilities": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
      "uniqueItems": true
    },
    "selection_mode": {
      "enum": [
        "precondition",
        "explicit",
        "goal_match",
        "goal_tie",
        "generic_fallback",
        "legacy_fallback",
        "workspace"
      ]
    },
    "evaluated_goal_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
      "uniqueItems": true
    },
    "matched_goal_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
      "uniqueItems": true
    },
    "candidate_workflows": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate_workflow"}
    },
    "safety_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persists_state", "authorizes_transactions"],
      "properties": {
        "persists_state": {"type": "boolean"},
        "authorizes_transactions": {"const": false}
      }
    }
  },
  "$defs": {
    "candidate_workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "goal_ids", "match_type", "reason_codes"],
      "properties": {
        "capability": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "goal_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "uniqueItems": true
        },
        "match_type": {
          "enum": [
            "exact_category",
            "category_and_subtype",
            "generic_allocation",
            "generic_review",
            "legacy_fallback",
            "explicit_request"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "uniqueItems": true
        }
      }
    }
  }
}
