{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/personal-finance-planner/financial-independence-input.schema.json",
  "title": "Financial Independence Calculation Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "birth_year",
    "base_year",
    "target_year",
    "annual_spending_scenarios_cny",
    "current_investable_assets_cny",
    "withdrawal_rates_pct",
    "real_return_rates_pct"
  ],
  "properties": {
    "birth_year": {"type": "integer", "minimum": 1900},
    "base_year": {"type": "integer", "minimum": 2000},
    "target_year": {"type": "integer", "minimum": 2001},
    "annual_spending_scenarios_cny": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number", "minimum": 0}
    },
    "current_investable_assets_cny": {"type": "number", "minimum": 0},
    "withdrawal_rates_pct": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 100}
    },
    "real_return_rates_pct": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number", "exclusiveMinimum": -100}
    },
    "annual_after_tax_income_cny": {"type": ["number", "null"], "minimum": 0},
    "income_start_year": {"type": ["integer", "null"]},
    "annual_stable_income_at_target_cny": {"type": "number", "minimum": 0, "default": 0},
    "one_time_goal_reserve_cny": {"type": "number", "minimum": 0, "default": 0},
    "current_year_annual_rent_cny": {"type": ["number", "null"], "minimum": 0},
    "current_year_annual_non_housing_spending_cny": {"type": ["number", "null"], "minimum": 0}
  }
}
